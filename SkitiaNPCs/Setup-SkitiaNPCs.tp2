BACKUP ~SkitiaNPCs/Backup~
AUTHOR ~Skitia; EET compilation maintained by Sauler89~
VERSION ~2.0.0-beta.1~
README ~README.md~

ALWAYS
  OUTER_SPRINT sn_emily ~SkitiaNPCs/BG1/Emily~
  OUTER_SPRINT sn_recorder ~SkitiaNPCs/BG1/Recorder~
  OUTER_SPRINT sn_vienxay ~SkitiaNPCs/BG1/Vienxay~
  INCLUDE ~%MOD_FOLDER%/Lib/fl#add_kit_ee.tpa~
  INCLUDE ~%MOD_FOLDER%/Lib/qd_multiclass.tpa~
END

LANGUAGE ~English~ ~English~ ~SkitiaNPCs/Tra/English/Setup.tra~

BEGIN ~SKITIA NPC BG:EE - Emily (with Isaac), Recorder and Vienxay~
DESIGNATED 0
REQUIRE_PREDICATE (GAME_IS ~eet~) ~Install this compilation in an EET game directory, after EET core.~
REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~EET_end.tp2~ 0) ~Install this compilation before EET_end.~
REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~Emily.tp2~ 0 AND NOT MOD_IS_INSTALLED ~Setup-Recorder.tp2~ 0 AND NOT MOD_IS_INSTALLED ~Vienxay.tp2~ 0) ~Uninstall the standalone BG1 Emily, Recorder and Vienxay mods before installing this compilation.~
REQUIRE_PREDICATE (NOT FILE_EXISTS_IN_GAME ~X3mily.cre~ AND NOT FILE_EXISTS_IN_GAME ~X3Rec.cre~ AND NOT FILE_EXISTS_IN_GAME ~X3Vien.cre~ AND NOT FILE_EXISTS_IN_GAME ~X3Isaac.cre~) ~These BG1 companions are already present. Remove the standalone packages, including copies imported from BGEE into EET, before installing this compilation.~

OUTER_SPRINT bg1_eet_symbol ~BG~
INCLUDE ~EET/other/cpmvars/eet_cpmvars.tpa~
INCLUDE ~%sn_emily%/lib/functions.tph~
INCLUDE ~%MOD_FOLDER%/Lib/BG1_Emily.tpa~
INCLUDE ~%sn_recorder%/Lib/functions.tph~
INCLUDE ~%MOD_FOLDER%/Lib/BG1_Recorder.tpa~
INCLUDE ~%sn_vienxay%/library/functions.tph~
INCLUDE ~%MOD_FOLDER%/Lib/BG1_Vienxay.tpa~
INCLUDE ~%MOD_FOLDER%/Lib/BG1_Crossmod.tpa~
INCLUDE ~%MOD_FOLDER%/Lib/Isaac_Artisan_Templates.tpa~
COPY ~%MOD_FOLDER%/Config/SNIBREQ.2da~ ~override/SNIBREQ.2da~
ACTION_IF (IDS_OF_SYMBOL (~kit~ ~C0_INVISIBLE_BLADE~) >= 0) THEN BEGIN
  INCLUDE ~%MOD_FOLDER%/Lib/Artisan_Isaac.tpa~
END ELSE BEGIN
  PRINT ~Isaac currently uses Skitia's original Invisible Blade. Install Artisan's Invisible Blade (7005) with the bundled compatibility hook before starting your game.~
END

BEGIN ~SKITIA NPC BG2:EE - Emily, Recorder and Vienxay~
DESIGNATED 1
REQUIRE_PREDICATE (GAME_IS ~eet~) ~Install this compilation in an EET game directory, after EET core.~
REQUIRE_PREDICATE (NOT MOD_IS_INSTALLED ~EET_end.tp2~ 0) ~Install this compilation before EET_end.~
REQUIRE_PREDICATE (NOT FILE_EXISTS_IN_GAME ~X3Emi.cre~ AND NOT FILE_EXISTS_IN_GAME ~X3Reb.cre~ AND NOT FILE_EXISTS_IN_GAME ~X3Vie.cre~) ~The BG2 companions are already present. Uninstall the previous/full Skitia NPCs package with its original installer before replacing its files.~

OUTER_SET bg2_chapter = 12
OUTER_FOR (i=1; i<=10; i=i+1) BEGIN
  OUTER_SET bg2_chapter = bg2_chapter + 1
  OUTER_SPRINT name_source ~bg2_chapter_%i%~
  OUTER_SET EVAL ~%name_source%~ = bg2_chapter
END
LOAD_TRA ~%MOD_FOLDER%/Tra/English/Setup.tra~
INCLUDE ~%MOD_FOLDER%/Lib/BG2_Main.tpa~
