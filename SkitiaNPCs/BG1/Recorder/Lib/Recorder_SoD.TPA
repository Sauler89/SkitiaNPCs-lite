//////////////////////////Siege of Dragonspear////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////
LOAD_TRA ~%sn_recorder%/Tra/%LANGUAGE%/Recorder_SoD.tra~
//CREATURES

COPY ~%sn_recorder%/cre/X32Rec.cre~ ~override/X32Rec.cre~
  SAY NAME1 @0
  SAY NAME2 @0
  WRITE_ASCII 0x248 ~X32Rec~ #8  //override script
  WRITE_ASCII 0x280 ~X3Rec~ #32  //DV
  WRITE_ASCII 0x2cc ~X32Rec~ #8   //pre-joining dialogue file
//  WRITE_ASCII 0X34 ~RecordM~ #8   //small portrait, we do not have one right now, comment out.
 // WRITE_ASCII 0x3c ~RecordL~ #8   //medium portrait, we do not have one right now, comment out. 
  SAY BIO @1
  SAY INITIAL_MEETING @2
  SAY MORALE @3 
  SAY HAPPY  @4
  SAY UNHAPPY_ANNOYED @5
  SAY UNHAPPY_SERIOUS @6
  SAY UNHAPPY_BREAKING_POINT ~~ [] 
  SAY LEADER @8
  SAY TIRED @9
  SAY BORED @10
  SAY BATTLE_CRY1 @11
  SAY BATTLE_CRY2 @12
  SAY BATTLE_CRY3 @13
  SAY BATTLE_CRY4 @14
  SAY BATTLE_CRY5 @15
  SAY DAMAGE @16
  SAY DYING @17
  SAY HURT @18
  SAY AREA_FOREST @19
  SAY AREA_CITY @20
  SAY AREA_DUNGEON @21
  SAY AREA_DAY @22
  SAY AREA_NIGHT @23
  SAY SELECT_COMMON1 @24
  SAY SELECT_COMMON2 @25
  SAY SELECT_COMMON3 @26
  SAY SELECT_COMMON4 @27
  SAY SELECT_COMMON5 @28
  SAY SELECT_COMMON6 @29
  SAY SELECT_ACTION1 @30
  SAY SELECT_ACTION2 @31
  SAY SELECT_ACTION3 @32
  SAY SELECT_ACTION4 @33
  SAY SELECT_ACTION5 @34
  SAY SELECT_ACTION6 @35
  SAY SELECT_ACTION7 @36
  SAY CRITICAL_HIT @37
  SAY CRITICAL_MISS @38
  SAY TARGET_IMMUNE @39
  SAY INVENTORY_FULL @40
  SAY SPELL_DISRUPTED @41
  SAY SET_A_TRAP ~~ []
  SAY HIDDEN_IN_SHADOWS ~~ []
  SAY PICKED_POCKET ~~ []
  WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~X3Bard~)) 
  
APPEND ~bddialog.2da~ ~X3Rec X32Rec X32RecJ X32RecD~ 
  UNLESS ~X3Rec~


////////////////DIALOGUES

COMPILE EVALUATE_BUFFER ~%sn_recorder%/dialogue/SoD/X32Rec.d~ USING ~%sn_recorder%/Tra/English/X32Rec.tra~
COMPILE EVALUATE_BUFFER ~%sn_recorder%/dialogue/SoD/X32RecJ.d~ USING ~%sn_recorder%/Tra/English/X32RecJ.tra~
COMPILE EVALUATE_BUFFER ~%sn_recorder%/dialogue/SoD/X32RCin.d~ USING ~%sn_recorder%/Tra/English/X32RCin.tra~
COMPILE EVALUATE_BUFFER ~%sn_recorder%/dialogue/SoD/X32Run.d~ USING ~%sn_recorder%/Tra/English/X32Run.tra~
COMPILE EVALUATE_BUFFER ~%sn_recorder%/dialogue/SoD/X32RB1.d~ USING ~%sn_recorder%/Tra/English/X32RB1.tra~


// Non-Area Scripts 
COMPILE EVALUATE_BUFFER ~%sn_recorder%/Scripts/SoD/X32Rec.baf~ USING ~%sn_recorder%/Tra/English/X32Rec.tra~
COMPILE EVALUATE_BUFFER ~%sn_recorder%/Scripts/SoD/X32RBant.baf~ USING ~%sn_recorder%/Tra/English/X32RBant.tra~
COMPILE EVALUATE_BUFFER ~%sn_recorder%/Scripts/SoD/X32RCin.baf~ USING ~%sn_recorder%/Tra/English/X32RCin.tra~
COMPILE EVALUATE_BUFFER ~%sn_recorder%/Scripts/SoD/X32Run.baf~ USING ~%sn_recorder%/Tra/English/X32Run.tra~
  COMPILE EVALUATE_BUFFER ~%sn_recorder%/Scripts/SOD/x3rcutg.baf~ 
  COMPILE EVALUATE_BUFFER ~%sn_recorder%/Scripts/SOD/X32RB1.baf~ USING ~%sn_recorder%/Tra/English/X32RB1.tra~ 
  COMPILE EVALUATE_BUFFER ~%sn_recorder%/Scripts/SOD/X32RB2.baf~ 
  COMPILE EVALUATE_BUFFER ~%sn_recorder%/Scripts/SOD/X32RB3.baf~ 
  COMPILE EVALUATE_BUFFER ~%sn_recorder%/Scripts/SOD/X32RB4.baf~ 
  COMPILE EVALUATE_BUFFER ~%sn_recorder%/Scripts/SOD/X32RB5.baf~ 
  COMPILE EVALUATE_BUFFER ~%sn_recorder%/Scripts/SOD/X32RB6.baf~   
  EXTEND_TOP ~bdintro.bcs~ ~%sn_recorder%/Scripts/SoD/bdintro.baf~
  EXTEND_TOP ~bdparty.bcs~ ~%sn_recorder%/Scripts/SoD/bdparty.baf~
  EXTEND_TOP ~bdcut08.bcs~ ~%sn_recorder%/Scripts/SoD/bdcut08.baf~   
   EXTEND_TOP ~bdcut58.bcs~ ~%sn_recorder%/Scripts/SOD/bdcut58.baf~
  EXTEND_TOP ~bdcut59b.bcs~ ~%sn_recorder%/Scripts/SOD/bdcut59b.baf~
  EXTEND_TOP ~bdcut61.bcs~ ~%sn_recorder%/Scripts/SOD/bdcut61.baf~  
   
  

////////////////Area SCRIPTS
  EXTEND_TOP ~bd0010.bcs~ ~%sn_recorder%/scripts/SoD/bd0010.baf~
  EXTEND_TOP ~bd0063.bcs~ ~%sn_recorder%/scripts/SoD/bd0063.baf~  
  EXTEND_TOP ~bd0066.bcs~ ~%sn_recorder%/scripts/SoD/bd0066.baf~   
  EXTEND_TOP ~bd0101.bcs~ ~%sn_recorder%/scripts/SoD/bd0101.baf~ 
  EXTEND_TOP ~bd0103.bcs~ ~%sn_recorder%/scripts/SoD/bd0103.baf~ 
  EXTEND_TOP ~bd0103.bcs~ ~%sn_recorder%/scripts/SoD/bd0104.baf~  
  EXTEND_TOP ~bd0120.bcs~ ~%sn_recorder%/scripts/SoD/bd0120.baf~  
  EXTEND_TOP ~bd1000.bcs~ ~%sn_recorder%/scripts/SoD/bd1000.baf~ 
  EXTEND_TOP ~bd2000.bcs~ ~%sn_recorder%/scripts/SoD/bd2000.baf~ 
  EXTEND_TOP ~bd3000.bcs~ ~%sn_recorder%/scripts/SoD/bd3000.baf~ 
  EXTEND_TOP ~bd4300.bcs~ ~%sn_recorder%/scripts/SoD/bd4300.baf~   
  EXTEND_TOP ~bd5300.bcs~ ~%sn_recorder%/scripts/SoD/bd5300.baf~   
  EXTEND_TOP ~bd7100.bcs~ ~%sn_recorder%/scripts/SoD/bd7100.baf~   
  EXTEND_TOP ~bd7300.bcs~ ~%sn_recorder%/scripts/SoD/bd7300.baf~     

///////////////Other Creatures 
COPY ~%sn_recorder%/cre/x32RCIN.cre~ ~override~
SAY NAME1 @42
SAY NAME2 @42
  WRITE_ASCII 0x248 ~X32RCIN~ #8  //override script
  WRITE_ASCII 0x280 ~X32RCIN~ #32  //DV
  WRITE_ASCII 0x2cc ~X32RCIN~ #8   //pre-joining dialogue file
  
