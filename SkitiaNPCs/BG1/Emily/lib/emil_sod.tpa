//Creatures 

// CREATURES  
COPY ~%sn_emily%/creatures/SOD/X32EHK1.cre~ ~override/X32EHK1.cre~
  SAY NAME1 @55 // ~Planar Hunter~
  SAY NAME2 @55 // ~Planar Hunter~
  WRITE_ASCII 0x280 ~X32EHK1~ #32  //DV  
COPY ~%sn_emily%/creatures/SOD/X32EHK2.cre~ ~override/X32EHK2.cre~
  SAY NAME1 @55 // ~Planar Hunter~
  SAY NAME2 @55 // ~Planar Hunter~
  WRITE_ASCII 0x280 ~X32EHK2~ #32  //DV 
COPY ~%sn_emily%/creatures/SOD/X32EHK3S.cre~ ~override/X32EHK3S.cre~
  SAY NAME1 @55 // ~Planar Hunter~
  SAY NAME2 @55 // ~Planar Hunter~
  WRITE_ASCII 0x248 ~X32EHK3S~ #8  //override script
  WRITE_ASCII 0x280 ~X32EHK3S~ #32  //DV
  WRITE_ASCII 0x2cc ~X32EHK3S~ #8   //Dialogue file  
COPY ~%sn_emily%/creatures/SOD/X32EHK4.cre~ ~override/X32EHK4.cre~
  SAY NAME1 @55 // ~Planar Hunter~
  SAY NAME2 @55 // ~Planar Hunter~  
  WRITE_ASCII 0x280 ~X32EHK4~ #32  //DV   
COPY ~%sn_emily%/creatures/SOD/X32Jacob.cre~ ~override/X32Jacob.cre~
  SAY NAME1 @71 // ~Jacob~
  SAY NAME2 @71 // ~Jacob~
  WRITE_ASCII 0x248 ~X32Jacob~ #8  //override script
  WRITE_ASCII 0x280 ~X32Jacob~ #32  //DV
  WRITE_ASCII 0x2cc ~X32Jacob~ #8   //Dialogue file    
  
  //Items 
  
  COPY_EXISTING ~%sn_emily%/Item/X3Bow05.itm~ ~override/X3Bow05.itm~
SAY NAME1 @128
SAY NAME2 @128
SAY DESC @129 

COPY_EXISTING ~%sn_emily%/Item/X3Bow06.itm~ ~override/X3Bow06.itm~
SAY NAME1 @130
SAY NAME2 @130
SAY DESC @131
  
LOAD_TRA ~%sn_emily%/tra/English/Emily.tra~  