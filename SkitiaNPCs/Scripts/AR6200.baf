//Emily Default Non-Romanced Ending 
IF
Global("StartEndBios","AR6200",1)
InParty("X3Emi")
!Global("X3EmiRomanceActive","GLOBAL",2)
!Global("X3EmiHeir","GLOBAL",1)
Global("X3EmiBio","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("X3EmiBio","GLOBAL",1)
TextScreen("X3EmiDN")
SmallWait(1)
Continue()
END
