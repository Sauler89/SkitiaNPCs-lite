Global("PlayerChoseEssence","GLOBAL",1)
!Global("X3RebQuest","GLOBAL",15)
Global("X3RebBio","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("X3RebBio","GLOBAL",1)
