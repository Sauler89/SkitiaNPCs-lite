LOAD_TRA ~%sn_vienxay%/Translations/English/Vienxay.tra~
ACTION_IF GAME_IS ~BGEE~ THEN BEGIN
OUTER_SPRINT "bg1_eet_symbol" AR
END

ACTION_IF GAME_IS ~EET~ THEN BEGIN
OUTER_SPRINT "bg1_eet_symbol" BG
END
  
INCLUDE ~%sn_vienxay%/library/Vien_items.tpa~  
INCLUDE ~%sn_vienxay%/library/vien_bg1.tpa~ 

ACTION_IF FILE_EXISTS_IN_GAME ~bdcaelar.cre~ THEN BEGIN
INCLUDE ~%sn_vienxay%/library/vien_sod.tpa~ 
END


COPY ~%sn_vienxay%/Portraits/VienxayL.bmp~ ~override/VienxayL.bmp~
     ~%sn_vienxay%/Portraits/VienxayM.bmp~ ~override/VienxayM.bmp~
     ~%sn_vienxay%/Portraits/VienxayS.bmp~ ~override/VienxayS.bmp~

LOAD_TRA ~%sn_vienxay%/Translations/English/Vienxay.tra~
// WeiDU records ACTION_READLN answers for automatic reinstallation.
PRINT ~Install Vienxay's BG1 dialogue music? [1] Yes [2] No~
OUTER_SPRINT sn_vien_music ~unset~
OUTER_WHILE (!(IS_AN_INT ~%sn_vien_music%~) OR (~%sn_vien_music%~ < 1) OR (~%sn_vien_music%~ > 2)) BEGIN
  ACTION_READLN sn_vien_music
END
OUTER_SET music = ~%sn_vien_music%~
ACTION_IF ("music" = 1) THEN BEGIN
	COPY_EXISTING ~sw1h01.itm~ ~override/bg1npcmusic.g3~

	MKDIR ~music/blank~
	COPY ~%sn_vienxay%/Music/blank.mus~ ~music~
		~%sn_vienxay%/Music/blank.acm~ ~music/blank/blanka.acm~

	COPY_EXISTING ~songlist.2da~ ~override~
  		SET_2DA_ENTRY 0 0 2 ~2DA_V1.0~
  		SET_2DA_ENTRY 0 1 2 ~~
  		SET_2DA_ENTRY 0 0 2 ~IDOBEK Name~
  		SET_2DA_ENTRY 1 2 3 ~Blank.mus~
		SET_2DA_ENTRY 1 1 3 ~BLANK~
  		SET_2DA_ENTRY 0 0 3 ~~
  		REPLACE_TEXTUALLY CASE_INSENSITIVE ~2DA_V1.0~ ~2DA V1.0~

LAF HANDLE_AUDIO
  STR_VAR
    audio_path = ~%sn_vienxay%/music~
    oggdec_path = ~%sn_vienxay%/music~
    sox_path = ~%sn_vienxay%/music~
END

PRINT @17
END 

